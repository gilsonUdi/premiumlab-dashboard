rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && currentUser().data.role == 'admin';
    }

    function isOwnUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function canCreateOwnCompanyProfile(userId) {
      return isOwnUser(userId)
        && request.resource.data.keys().hasOnly([
          'role', 'email', 'name', 'companyId', 'companySlug', 'active', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'role', 'email', 'name', 'companyId', 'companySlug', 'active'
        ])
        && request.resource.data.role == 'company'
        && request.resource.data.active == true
        && request.resource.data.email == request.auth.token.email
        && exists(/databases/$(database)/documents/companies/$(request.resource.data.companyId))
        && get(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.email == request.resource.data.email
        && get(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.slug == request.resource.data.companySlug;
    }

    match /users/{userId} {
      allow read: if isOwnUser(userId) || isAdmin();
      allow create: if canCreateOwnCompanyProfile(userId) || isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /companies/{companyId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /companySecrets/{companyId} {
      allow read, write: if false;
    }

    match /tenants/{tenantId} {
      allow read, write: if true;
    }

    match /morning_call_contacts/{contactId} {
      allow read, write: if true;
    }

    match /powerbi_configs/{configId} {
      allow read, write: if true;
    }

    match /morning_call_executions/{executionId} {
      allow read, write: if true;
    }

    match /consulta_ia_companies/{companyId} {
      allow read, write: if true;
    }

    match /consulta_ia_clients/{clientId} {
      allow read, write: if true;
    }

    match /consulta_ia_executions/{executionId} {
      allow read, write: if true;
    }

    match /sac_companies/{companyId} {
      allow read, write: if true;
    }
  }
}
