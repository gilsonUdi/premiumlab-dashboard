# Somente backend. Nunca usar prefixo NEXT_PUBLIC para estas variáveis.
NFSE_ENABLED=false
NFSE_ENVIRONMENT=test
NFSE_PRODUCTION_ENABLED=false

# Série exclusiva deste aplicativo, confirmada antes da primeira emissão (1..49999).
# NÃO copiar a série 70013 das notas municipais de referência.
NFSE_DPS_SERIES_TEST=
NFSE_DPS_SERIES_PRODUCTION=
NFSE_DPS_INITIAL_NUMBER_TEST=1
NFSE_DPS_INITIAL_NUMBER_PRODUCTION=1

# Escolher UMA origem. Arquivo precisa existir DENTRO DO SERVIDOR, fora de public/.
NFSE_A1_PFX_PATH=
NFSE_A1_PFX_BASE64=
NFSE_A1_PASSWORD=

# Opcional: somente os dois caminhos oficiais de homologação permitidos no código.
# NFSE_SEFIN_TEST_BASE_URL=https://sefin.producaorestrita.nfse.gov.br/SefinNacional
